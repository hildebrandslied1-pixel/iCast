# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghi

# ── AI Features (optional but recommended) ────────────────────────────────────
# OpenAI API key — used for Whisper audio transcription
OPENAI_API_KEY=sk-...

# DeepSeek API key — used for episode summaries and detailed breakdowns
# Get one at: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on (Railway sets this automatically)
PORT=8080

# Session secret for Express sessions
SESSION_SECRET=change-me-to-a-random-string
